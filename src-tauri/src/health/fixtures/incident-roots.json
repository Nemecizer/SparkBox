    {"name": "a link that flaps on its own", "alert": {"rule": "fabric-flap", "kind": "interface", "id": "enp1s0f1np1", "node": "cell2"}, "active": [], "root": "link:cell2/enp1s0f1np1"},
    {"name": "a flap on an interface with a RoCE alert is that link's incident", "alert": {"rule": "fabric-flap", "kind": "interface", "id": "enP2p1s0f1np1", "node": "cell2"}, "active": [{"rule": "roce-iface", "kind": "interface", "id": "enP2p1s0f1np1", "node": "cell2"}], "root": "link:cell2/enP2p1s0f1np1"},
    {"name": "both halves of one node are the node's fabric incident", "alert": {"rule": "roce-iface", "kind": "interface", "id": "enp1s0f1np1", "node": "cell2"}, "active": [{"rule": "roce-iface", "kind": "interface", "id": "enP2p1s0f1np1", "node": "cell2"}], "root": "node:cell2"},
    {"name": "and so is the other half's flap", "alert": {"rule": "fabric-flap", "kind": "interface", "id": "enP2p1s0f1np1", "node": "cell2"}, "active": [{"rule": "roce-iface", "kind": "interface", "id": "enp1s0f1np1", "node": "cell2"}], "root": "node:cell2"},
    {"name": "and the switch port both halves are cabled to", "alert": {"rule": "port-errors", "kind": "port", "id": "qsfp56-dd-1-2", "node": "cell2", "switch": "crs804"}, "active": [{"rule": "roce-iface", "kind": "interface", "id": "enp1s0f1np1", "node": "cell2"}, {"rule": "roce-iface", "kind": "interface", "id": "enP2p1s0f1np1", "node": "cell2"}], "root": "node:cell2"},
    {"name": "halves of different nodes stay their own links", "alert": {"rule": "roce-iface", "kind": "interface", "id": "enp1s0f1np1", "node": "cell2"}, "active": [{"rule": "roce-iface", "kind": "interface", "id": "enp1s0f1np1", "node": "cell3"}], "root": "link:cell2/enp1s0f1np1"},
    {"name": "a model down on its own", "alert": {"rule": "endpoint-down", "kind": "endpoint", "id": "cell1-vllm-8000", "node": "cell1"}, "active": [], "root": "endpoint:cell1-vllm-8000"},
    {"name": "a model down because a stage's node is offline is that node's", "alert": {"rule": "endpoint-down", "kind": "endpoint", "id": "cell1-vllm-8000", "node": "cell1"}, "active": [{"rule": "node-offline", "kind": "node", "id": "cell3", "node": "cell3"}], "root": "node:cell3"},
    {"name": "a model down because a stage lost the fabric", "alert": {"rule": "endpoint-down", "kind": "endpoint", "id": "cell1-vllm-8000", "node": "cell1"}, "active": [{"rule": "fabric-down", "kind": "interface", "id": "enp1s0f1np1", "node": "cell2"}], "root": "node:cell2"},
    {"name": "a model down on a GPU fault is the GPU's", "alert": {"rule": "endpoint-down", "kind": "endpoint", "id": "gx10-0000-ollama-11434", "node": "gx10-0000"}, "active": [], "root": "gpu:gx10-0000"},
    {"name": "a member container crash-looping is its model's", "alert": {"rule": "crash-loop", "kind": "container", "id": "vllm-worker", "node": "cell2"}, "active": [], "root": "endpoint:cell1-vllm-8000"},
    {"name": "a member container that exited is its model's", "alert": {"rule": "container-exited", "kind": "container", "id": "vllm-head", "node": "cell1"}, "active": [], "root": "endpoint:cell1-vllm-8000"},
    {"name": "a container that serves no model is its own", "alert": {"rule": "container-exited", "kind": "container", "id": "sglang-test", "node": "gx10-0000"}, "active": [], "root": "container:gx10-0000/sglang-test"},
    {"name": "an Xid is the GPU's", "alert": {"rule": "kernel-xid", "kind": "gpu", "id": "xid-79", "node": "gx10-0000"}, "active": [], "root": "gpu:gx10-0000"},
    {"name": "and so is an unreadable GPU", "alert": {"rule": "gpu-unreadable", "kind": "gpu", "id": "gpu0", "node": "gx10-0000"}, "active": [], "root": "gpu:gx10-0000"},
    {"name": "a node's own condition is its node's", "alert": {"rule": "mem-high", "kind": "node", "id": "cell3", "node": "cell3"}, "active": [], "root": "node:cell3"},
    {"name": "anything else is its own entity", "alert": {"rule": "disk-full", "kind": "disk", "id": "/", "node": "gx10-0000"}, "active": [], "root": "disk:gx10-0000//"},
    {"name": "lostHomeNetwork: this Mac's router doesn't answer, and a node offline is the Mac's incident", "macOnly": true, "macReach": "lostHomeNetwork", "unreachable": ["cell1", "cell2", "cell3", "gx10-0000"], "alert": {"rule": "node-offline", "kind": "node", "id": "cell1", "node": "cell1"}, "active": [{"rule": "mac-reach", "kind": "mac", "id": "reach"}], "root": "mac:reach"},
    {"name": "lanBetween: the router answers and no node does: one incident for this Mac, the nodes its children", "macOnly": true, "macReach": "lanBetween", "unreachable": ["cell1", "cell2", "cell3", "gx10-0000"], "alert": {"rule": "node-offline", "kind": "node", "id": "gx10-0000", "node": "gx10-0000"}, "active": [{"rule": "mac-reach", "kind": "mac", "id": "reach"}, {"rule": "node-offline", "kind": "node", "id": "cell1", "node": "cell1"}], "root": "mac:reach"},
    {"name": "lanBetween: and the mac-reach warning itself", "macOnly": true, "macReach": "lanBetween", "unreachable": ["cell1", "cell2", "cell3", "gx10-0000"], "alert": {"rule": "mac-reach", "kind": "mac", "id": "reach"}, "active": [], "root": "mac:reach"},
    {"name": "lanBetween: a model down on a node this Mac can't reach is the Mac's too", "macOnly": true, "macReach": "lanBetween", "unreachable": ["cell1", "cell2", "cell3", "gx10-0000"], "alert": {"rule": "endpoint-down", "kind": "endpoint", "id": "gx10-0000-ollama-11434", "node": "gx10-0000"}, "active": [{"rule": "mac-reach", "kind": "mac", "id": "reach"}, {"rule": "node-offline", "kind": "node", "id": "gx10-0000", "node": "gx10-0000"}], "root": "mac:reach"},
    {"name": "lanBetween: so is a switch that doesn't answer", "macOnly": true, "macReach": "lanBetween", "unreachable": ["cell1", "cell2", "cell3", "gx10-0000"], "alert": {"rule": "switch-unreachable", "kind": "switch", "id": "crs804", "node": null, "switch": "crs804"}, "active": [{"rule": "mac-reach", "kind": "mac", "id": "reach"}], "root": "mac:reach"},
    {"name": "wiredSwitch: only cell3's Wi-Fi answers, and its wired row is the Mac's", "macOnly": true, "macReach": "wiredSwitch", "unreachable": ["cell1", "cell2", "cell3", "gx10-0000"], "alert": {"rule": "node-offline", "kind": "node", "id": "cell3", "node": "cell3"}, "active": [{"rule": "mac-reach", "kind": "mac", "id": "reach"}], "root": "mac:reach"},
    {"name": "vpnProblem: the VPN in error while away, a node offline is the Mac's", "macOnly": true, "macReach": "vpnProblem", "unreachable": ["cell1", "cell2", "cell3", "gx10-0000"], "alert": {"rule": "node-offline", "kind": "node", "id": "cell2", "node": "cell2"}, "active": [{"rule": "mac-reach", "kind": "mac", "id": "reach"}], "root": "mac:reach"},
    {"name": "noRoute: no network route at all", "macOnly": true, "macReach": "noRoute", "unreachable": ["cell1", "cell2", "cell3", "gx10-0000"], "alert": {"rule": "node-offline", "kind": "node", "id": "cell3", "node": "cell3"}, "active": [{"rule": "mac-reach", "kind": "mac", "id": "reach"}], "root": "mac:reach"},
    {"name": "with this Mac's path fine, a node offline is its own", "macOnly": true, "macReach": "ok", "unreachable": ["cell3"], "alert": {"rule": "node-offline", "kind": "node", "id": "cell3", "node": "cell3"}, "active": [], "root": "node:cell3"},
    {"name": "a node that answers isn't the Mac's even while the Mac can't reach the others", "macOnly": true, "macReach": "lanBetween", "unreachable": ["cell1", "cell2", "cell3"], "alert": {"rule": "mem-high", "kind": "node", "id": "gx10-0000", "node": "gx10-0000"}, "active": [{"rule": "mac-reach", "kind": "mac", "id": "reach"}], "root": "node:gx10-0000"},
