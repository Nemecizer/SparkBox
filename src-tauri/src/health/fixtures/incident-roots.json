    {"node": "cell2", "iface": "enp1s0f1np1", "ip": "192.168.100.2", "switchPort": "crs804/qsfp56-dd-1-2"},
    {"node": "cell2", "iface": "enP2p1s0f1np1", "ip": "192.168.101.2", "switchPort": "crs804/qsfp56-dd-1-2"},
    {"node": "cell3", "iface": "enp1s0f1np1", "ip": "192.168.100.3", "switchPort": "crs804/qsfp56-dd-2-1"},
    {"node": "cell3", "iface": "enP2p1s0f1np1", "ip": "192.168.101.3", "switchPort": "crs804/qsfp56-dd-2-1"}
