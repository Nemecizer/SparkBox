  "gpuFault": ["gx10-0000"],
  "endpoints": [
    {"id": "cell1-vllm-8000", "headNode": "cell1", "nodes": ["cell1", "cell2", "cell3"], "containers": ["vllm-head", "vllm-worker"], "missingNodes": []},
    {"id": "gx10-0000-ollama-11434", "headNode": "gx10-0000", "nodes": ["gx10-0000"], "containers": ["ollama"], "missingNodes": []}
  ],
  "cases": [
    {"name": "RoCE on an interface is its link", "alert": {"rule": "roce-iface", "kind": "interface", "id": "enP2p1s0f1np1", "node": "cell2"}, "active": [], "root": "link:cell2/enP2p1s0f1np1"},
    {"name": "the switch port's errors join the half with the RoCE alert", "alert": {"rule": "port-errors", "kind": "port", "id": "qsfp56-dd-1-2", "node": "cell2", "switch": "crs804"}, "active": [{"rule": "roce-iface", "kind": "interface", "id": "enP2p1s0f1np1", "node": "cell2"}], "root": "link:cell2/enP2p1s0f1np1"},
    {"name": "a weak optic with no RoCE alert is the first half cabled to it", "alert": {"rule": "optic-rx-low", "kind": "port", "id": "qsfp56-dd-1-2", "node": "cell2", "switch": "crs804"}, "active": [], "root": "link:cell2/enp1s0f1np1"},
    {"name": "errors on a port no node is cabled to are the switch's", "alert": {"rule": "port-errors", "kind": "port", "id": "qsfp56-dd-4-2", "node": null, "switch": "crs804"}, "active": [], "root": "switch:crs804"},
    {"name": "a switch that doesn't answer", "alert": {"rule": "switch-unreachable", "kind": "switch", "id": "crs804", "node": null, "switch": "crs804"}, "active": [], "root": "switch:crs804"},
    {"name": "a node offline", "alert": {"rule": "node-offline", "kind": "node", "id": "cell3", "node": "cell3"}, "active": [], "root": "node:cell3"},
    {"name": "not updating", "alert": {"rule": "node-stale", "kind": "node", "id": "cell1", "node": "cell1"}, "active": [], "root": "node:cell1"},
    {"name": "its agent", "alert": {"rule": "agent-silent", "kind": "node", "id": "cell2", "node": "cell2"}, "active": [], "root": "node:cell2"},
    {"name": "its agent's settings", "alert": {"rule": "agent-config-stale", "kind": "node", "id": "cell3", "node": "cell3"}, "active": [], "root": "node:cell3"},
    {"name": "a fabric link down is the node's", "alert": {"rule": "fabric-down", "kind": "interface", "id": "enp1s0f1np1", "node": "cell2"}, "active": [], "root": "node:cell2"},
    {"name": "its switch port down is the node's", "alert": {"rule": "port-down", "kind": "port", "id": "qsfp56-dd-2-1", "node": "cell3", "switch": "crs804"}, "active": [], "root": "node:cell3"},
